const title = "Saved an AVIF image you can't open? Convert it";
const description = 'Why AVIF files are hard to open in older apps, and how to turn one into a JPG or PNG in the browser, with or without transparency.';
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
