---
import Base from '../../../layouts/Base.astro';
import { SITE } from '../../../site';
const title = 'How to export a Google or Outlook calendar to Excel';
const description = 'Google, Outlook and Apple Calendar can all hand you a calendar file. Turn it into a spreadsheet with one row per event, ready to count or filter in Excel.';
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: '2026-11-23',
    author: { '@type': 'Organization', name: 'Stayfile' },
    publisher: { '@type': 'Organization', name: 'Stayfile' },
  },
