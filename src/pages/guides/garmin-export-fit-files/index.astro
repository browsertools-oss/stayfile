---
import Base from '../../../layouts/Base.astro';
import { SITE } from '../../../site';
const title = 'Where the FIT files are in a Garmin data export';
const description = 'A Garmin export hides the activity FIT files in inner zips under DI_CONNECT. Where they are, why you unzip twice, and how to get them out.';
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: '2026-11-26',
    author: { '@type': 'Organization', name: 'Stayfile' },
    publisher: { '@type': 'Organization', name: 'Stayfile' },
  },
