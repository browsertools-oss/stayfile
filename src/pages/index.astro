---
// avoid-ai-design-ignore-file: K7 (every :focus-visible rule lives in src/styles/site.css, loaded by Base.astro)
import Base from '../layouts/Base.astro';
import Silhouette from '../components/Silhouette.astro';
import Drop from '../components/Drop.astro';
import { SITE, PAGES, GROUPS, GROUP_ID } from '../site';
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: PAGES.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.h1, url: new URL(`/${p.slug}/`, SITE.url).href })),
  },
];
---
<Base
  title="Stayfile: PDF, image and CSV tools that never upload your files"
  description="Merge and split PDFs, convert and compress images, and turn CSV into JSON or Excel. Everything runs in your browser, so your files stay on your device."
  path="/"
  jsonld={jsonld}
>
  <div class="board bleed home">
    <div class="wall">
      <h1>File tools that keep your files on your device</h1>
      <p class="lede">Each tool here runs inside your browser tab. The files you open are read and changed on your own computer, and none of them is uploaded.</p>
      <section class="tool start" data-family="any" aria-label="Start with your files">
        <Drop accept=".pdf,image/*,.heic,.heif,.csv,.tsv,.json,.jsonl,.ndjson" multiple take={false} main="Drop files here, or <u>choose files</u>" sub="PDFs, images, iPhone photos, CSV or JSON. You pick what to do next." />
        <div class="routes" id="routes" hidden>
          <p class="routes-line" id="routesLine" aria-live="polite"></p>
          <div class="routes-row" id="routesRow"></div>
          <button type="button" class="link" id="routesReset">Choose other files</button>
        </div>
      </section>
      <p class="or">Or pick a tool</p>
      <div class="zones">
        {GROUPS.map((g) => (
          <section class="zone" id={GROUP_ID[g]} aria-labelledby={`g-${GROUP_ID[g]}`}>
            <h2 id={`g-${GROUP_ID[g]}`}>{g}</h2>
            <ul class="hooks">
              {PAGES.filter((p) => p.group === g).map((p) => (
                <li>
                  <a class="hook" href={`/${p.slug}/`}>
                    <Silhouette slug={p.slug} />
                    <span class="t">{p.card}</span>
                    <span class="sr">{p.blurb}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </div>
  <section class="row how">
    <h2>How can it work without uploading?</h2>
    <div>
      <figure class="trip" aria-hidden="true">
        <svg viewBox="0 0 560 120">
          <g class="leg"><path class="body" d="M24 22h40l14 14v62H24z" /><path class="cut" d="M64 22v14h14M36 56h30M36 68h30M36 80h18" /></g>
          <path class="wire" d="M100 60h70" /><path class="head" d="M164 52l10 8l-10 8" />
          <g class="leg"><rect class="body" x="196" y="20" width="168" height="80" rx="6" /><path class="cut" d="M196 38h168M212 29h1M222 29h1M232 29h1" /><path class="body tagged" d="M254 52h52v36h-52z" /></g>
          <path class="wire" d="M386 60h70" /><path class="head" d="M450 52l10 8l-10 8" />
          <g class="leg"><path class="body" d="M482 22h40l14 14v62h-54z" /><path class="cut" d="M522 22v14h14M509 50v30M497 68l12 12l12 -12" /></g>
        </svg>
        <figcaption><span>Your file</span><span>This tab</span><span>Your download</span></figcaption>
      </figure>
      <p class="prose">Your browser can already read files and run code, so the page brings the code to your file instead of sending your file to a server. When you open a PDF here, it is read into memory in this tab, changed there, and handed back to you as a download. Close the tab and it is gone. You can check this yourself: open your browser’s developer tools, switch to the Network tab and watch while you use a tool. No file goes out.</p>
    </div>
  </section>
</Base>
<script>
  import { suggestTools, describeDrop } from '../lib/route';
  import { handOff } from '../lib/handoff';
  const drop = document.getElementById('drop')!;
  const routes = document.getElementById('routes')!;
  const row = document.getElementById('routesRow')!;
  const line = document.getElementById('routesLine')!;
  let held: File[] = [];
  function show(files: File[]) {
    held = files;
    const opts = suggestTools(files);
    row.innerHTML = '';
    if (!opts.length) {
      line.textContent = 'No single tool here takes all of these together. Try one kind of file at a time.';
    } else if (opts.length === 1) {
      // Only one thing to do, so do it.
      line.textContent = `Opening ${opts[0].label.toLowerCase()}…`;
      handOff(files, opts[0].slug);
    } else {
      line.textContent = describeDrop(files);
      for (const [i, r] of opts.entries()) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = i === 0 ? 'primary' : 'chip';
        b.textContent = r.label;
        b.onclick = () => { b.disabled = true; handOff(held, r.slug); };
        row.append(b);
      }
    }
    routes.hidden = false;
    drop.classList.add('compact');
    row.querySelector<HTMLButtonElement>('button')?.focus();
  }
  drop.addEventListener('files', (e) => show((e as CustomEvent<File[]>).detail));
  document.getElementById('routesReset')!.addEventListener('click', () => {
    held = []; routes.hidden = true; drop.classList.remove('compact');
    (document.getElementById('file') as HTMLInputElement).click();
  });
</script>
<style>
  .start { margin: 0 0 var(--space-sm); }
  .routes { padding-top: var(--space-md); display: grid; gap: var(--space-sm); justify-items: start; }
  .routes-line { margin: 0; font-weight: 700; color: var(--color-ink); }
  .routes-row { display: flex; flex-wrap: wrap; gap: var(--space-sm); align-items: center; }
  .routes .link { padding: 0; }
  .or { margin: var(--space-2xl) 0 var(--space-md); padding-top: var(--space-sm); border-top: var(--rule-bar) solid var(--color-ink); font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: clamp(1.8rem, 3.6vw, 2.6rem); line-height: 1; color: var(--color-ink); }
  .home { padding-bottom: var(--space-2xl); }
  .home h1 { max-width: 24ch; font-size: clamp(2.3rem, 5.4vw, 4.75rem); }
  .zones { display: grid; gap: var(--space-xl); }
  .zone { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: var(--space-sm) var(--space-lg); align-items: start; scroll-margin-top: var(--space-md); }
  .zone > h2 { font-size: var(--text-lg); margin: var(--space-sm) 0 0; max-width: 12ch; text-wrap: balance; }
  /* the stencil board: tools on hairlines */
  .hooks { list-style: none; margin: 0; padding: 0 1px 1px 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); }
  .hooks li { border: var(--rule-hair) solid var(--color-ink); margin: 0 -1px -1px 0; }
  .hooks li:first-child { grid-column: span 2; grid-row: span 2; }
  @media (min-width: 1000px) { .hooks { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .hook { display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: var(--space-xs); height: 100%; padding: var(--space-md) var(--space-xs) var(--space-sm); color: var(--color-ink); text-decoration: none; --cut: var(--color-paper-2); transition: background-color var(--dur-micro) var(--ease-out); }
  .hook :global(.sil) { width: 100%; max-width: 112px; margin-block: auto; }
  li:first-child > .hook :global(.sil) { max-width: 240px; }
  .hook .t { font-weight: 600; font-size: var(--text-sm); line-height: 1.25; text-align: center; }
  li:first-child > .hook .t { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: var(--text-lg); line-height: 1; }
  .hook:hover { background: var(--color-plate); color: var(--color-ink); --cut: var(--color-plate); }
  .hook:hover .t { text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 3px; text-underline-offset: 0.2em; }
  .hook:active { background: var(--color-paper-3); --cut: var(--color-paper-3); }
  .hook:focus-visible { outline: 3px solid var(--color-focus); outline-offset: -3px; }

  .trip { margin: 0 0 var(--space-lg); max-width: 560px; }
  .trip svg { display: block; width: 100%; }
  .trip .body { fill: var(--color-ink); }
  .trip .tagged { fill: var(--color-accent); }
  .trip .cut { fill: none; stroke: var(--color-paper); stroke-width: 3; stroke-linecap: square; }
  .trip .wire { stroke: var(--color-ink); stroke-width: 3; stroke-dasharray: 8 6; }
  .trip .head { fill: none; stroke: var(--color-ink); stroke-width: 3; stroke-linejoin: miter; }
  .trip figcaption { position: relative; height: 1.5em; font-size: var(--text-sm); font-weight: 600; color: var(--color-ink); margin-top: var(--space-xs); }
  .trip figcaption span { position: absolute; top: 0; translate: -50% 0; white-space: nowrap; }
  .trip figcaption span:nth-child(1) { left: 9.1%; translate: -30% 0; }
  .trip figcaption span:nth-child(2) { left: 50%; }
  .trip figcaption span:nth-child(3) { left: 90.9%; translate: -70% 0; }
  .prose { max-width: 66ch; margin: 0; }
  .how { margin-top: 0; }

  @media (max-width: 760px) {
    .zone { grid-template-columns: 1fr; }
    .zone > h2 { margin-top: 0; max-width: none; }
    .hooks { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .hooks li:first-child { grid-column: span 3; grid-row: auto; }
    li:first-child > .hook :global(.sil) { max-width: 150px; }
    .hook { padding: var(--space-sm) var(--space-2xs); }
    .hook .t { font-size: var(--text-xs); }
    li:first-child > .hook .t { font-size: var(--text-md); }
  }
</style>
