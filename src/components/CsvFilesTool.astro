---
import Drop from './Drop.astro';
import type { Tool } from '../site';

interface Props { tool: Tool; slug: string }
const { tool, slug } = Astro.props;
const merge = tool === 'csv-merge';
---

<section class="tool" data-tool={tool} data-slug={slug}>
  <ul class="files" id="list"></ul>
  {merge
    ? <Drop accept=".csv,.tsv,.txt,text/csv" multiple main="Drop CSV files here, or <u>choose files</u>" sub="CSV files, in the order you add them" />
    : <Drop accept=".csv,.tsv,.txt,text/csv" main="Drop a CSV file here, or <u>choose one</u>" sub="CSV files" />}

  <div class="opts" id="opts" hidden>
    {merge
      ? <label><input type="checkbox" id="addName" /> Add a column with the file name</label>
      : <>
          <div class="seg" role="radiogroup" aria-label="How to split">
            <label><input type="radio" name="mode" value="rows" checked /><span>Rows per file</span></label>
            <label><input type="radio" name="mode" value="files" /><span>Number of files</span></label>
            <label><input type="radio" name="mode" value="column" /><span>One file per value</span></label>
          </div>
          <label id="rowsWrap">Rows per file <input type="number" id="rows" min="1" value="100000" /></label>
          <label id="filesWrap" hidden>Number of files <input type="number" id="files" min="1" value="2" /></label>
          <label id="colWrap" hidden>Column <select id="col"></select></label>
          <label><input type="checkbox" id="header" checked /> First row is a header, repeat it in every file</label>
        </>}
  </div>

  <div class="actions" id="actions" hidden>
    <button type="button" class="primary" id="go" disabled>{merge ? 'Download merged CSV' : 'Split'}</button>
    <span class="status" id="status" aria-live="polite"></span>
  </div>

  <div class="done" id="done" role="status" hidden></div>
  <p class="error" id="err" role="alert" hidden></p>
</section>

<script>
  import Papa from 'papaparse';
  import { save, zip, baseName, withBom } from '../lib/save';
  import { savedLine } from '../lib/route';
  import { showDone, hideDone } from '../lib/done';
  import { makeSplitter, makeValueSplitter, valuePartName, mergeCsv, partName, rowsPerPartFor } from '../lib/csvfiles';

  const root = document.querySelector<HTMLElement>('.tool')!;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const list = $('list')!, drop = $('drop')!, go = $<HTMLButtonElement>('go')!;
  const opts = $('opts')!, actions = $('actions')!, status = $('status')!;
  const err = $('err')!, doneEl = $('done')!;
  const merge = root.dataset.tool === 'csv-merge';
  const rows = $<HTMLInputElement>('rows');
  const files = $<HTMLInputElement>('files');
  const rowsWrap = $('rowsWrap'), filesWrap = $('filesWrap');
  const colWrap = $('colWrap'), colSel = $<HTMLSelectElement>('col');
  const header = $<HTMLInputElement>('header');
  const addName = $<HTMLInputElement>('addName');
  const mode = () => document.querySelector<HTMLInputElement>('input[name="mode"]:checked')?.value ?? 'rows';

  let file: File | null = null;
  let mergeFiles: File[] = [];
  const BOM_CHAR = String.fromCharCode(0xfeff);

  function syncMode() {
    if (merge || !rowsWrap || !filesWrap) return;
    const m = mode();
    rowsWrap.hidden = m !== 'rows';
    filesWrap.hidden = m !== 'files';
    if (colWrap) colWrap.hidden = m !== 'column' || !colSel?.options.length;
    if (header) {
      if (m === 'column') {
        header.checked = true;
        header.disabled = true;
      } else {
        header.disabled = false;
      }
    }
  }

  function showFile(f: File) {
    file = f;
    list.innerHTML = '';
    const li = document.createElement('li');
    const name = document.createElement('span');
    name.className = 'name';
    name.textContent = f.name;
    li.append(name);
    list.append(li);
    opts.hidden = false;
    actions.hidden = false;
    go.disabled = false;
    hideDone(doneEl);
    err.hidden = true;
    status.textContent = '';
    fillColumns(f);
  }

  /** Fill the column picker from the first row of the file. */
  function fillColumns(f: File) {
    if (!colSel || !colWrap) return;
    colSel.innerHTML = '';
    colWrap.hidden = true;
    Papa.parse<string[]>(f as unknown as string, {
      preview: 1,
      complete: (res) => {
        const first = (res.data as string[][])[0] ?? [];
        first.forEach((name, i) => {
          const raw = name ?? '';
          const cell = raw.charCodeAt(0) === 0xfeff ? raw.slice(1) : raw;
          const o = document.createElement('option');
          o.value = String(i);
          o.textContent = cell || `Column ${i + 1}`;
          colSel.append(o);
        });
        syncMode();
      },
      error: () => {
        colWrap.hidden = true;
      },
    });
  }

  /** Read the file again and hand back one CSV string per value in one column. */
  function splitByValue(f: File, column: number, bom: boolean): Promise<{ parts: { value: string; csv: string }[]; rows: number }> {
    return new Promise((resolve, reject) => {
      const parts: { value: string; csv: string }[] = [];
      let dataRows = 0;
      let first = true;
      const splitter = makeValueSplitter({
        column,
        onPart: (value, csv) => {
          status.textContent = `Writing ${value || 'blank'}...`;
          parts.push({ value, csv });
        },
      });
      Papa.parse<string[]>(f as unknown as string, {
        skipEmptyLines: true,
        chunk: (res) => {
          const data = res.data as string[][];
          for (const row of data) {
            if (header?.checked && first) {
              const cell = row[0] ?? '';
              if (cell.charCodeAt(0) === 0xfeff) row[0] = cell.slice(1);
              first = false;
              continue;
            }
            first = false;
            if (!(row.length === 1 && (row[0] ?? '') === '')) dataRows++;
          }
          splitter.push(data);
        },
        complete: () => {
          splitter.end();
          resolve({ parts, rows: dataRows });
        },
        error: (e: unknown) => reject(e),
      });
    });
  }

  async function hasBom(f: File): Promise<boolean> {
    const head = new Uint8Array(await f.slice(0, 3).arrayBuffer());
    return head.length === 3 && head[0] === 0xef && head[1] === 0xbb && head[2] === 0xbf;
  }

  /** Read the whole file once and count the data rows. */
  function countRows(f: File): Promise<number> {
    return new Promise((resolve, reject) => {
      let seen = 0;
      let first = true;
      Papa.parse<string[]>(f as unknown as string, {
        skipEmptyLines: true,
        chunk: (res) => {
          const data = res.data as string[][];
          if (first && data.length && header.checked) {
            const cell = data[0][0] ?? '';
            if (cell.charCodeAt(0) === 0xfeff) data[0][0] = cell.slice(1);
          }
          for (const row of data) {
            if (header.checked && first) {
              first = false;
              continue;
            }
            first = false;
            if (!(row.length === 1 && (row[0] ?? '') === '')) seen++;
          }
        },
        complete: () => resolve(seen),
        error: (e: unknown) => reject(e),
      });
    });
  }

  /** Read the file again and hand back one CSV string per part. */
  function splitFile(f: File, per: number, bom: boolean): Promise<{ parts: string[]; rows: number }> {
    return new Promise((resolve, reject) => {
      const parts: string[] = [];
      let dataRows = 0;
      let first = true;
      let n = 0;
      const splitter = makeSplitter({
        header: header.checked,
        rowsPerPart: per,
        onPart: (csv) => {
          n++;
          status.textContent = `Writing part ${n}...`;
          parts.push((bom ? BOM_CHAR : '') + csv);
        },
      });
      Papa.parse<string[]>(f as unknown as string, {
        skipEmptyLines: true,
        chunk: (res) => {
          const data = res.data as string[][];
          for (const row of data) {
            if (header.checked && first) {
              const cell = row[0] ?? '';
              if (cell.charCodeAt(0) === 0xfeff) row[0] = cell.slice(1);
              first = false;
              continue;
            }
            first = false;
            if (!(row.length === 1 && (row[0] ?? '') === '')) dataRows++;
          }
          splitter.push(data);
        },
        complete: () => {
          splitter.end();
          resolve({ parts, rows: dataRows });
        },
        error: (e: unknown) => reject(e),
      });
    });
  }

  function renderMerge() {
    list.innerHTML = '';
    mergeFiles.forEach((f, i) => {
      const li = document.createElement('li');
      const name = document.createElement('span');
      name.className = 'name';
      name.textContent = f.name;
      li.append(name);
      const move = (to: number) => {
        const [it] = mergeFiles.splice(i, 1);
        mergeFiles.splice(to, 0, it);
        renderMerge();
      };
      const mk = (label: string, title: string, fn: () => void, disabled: boolean) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'link';
        b.textContent = label;
        b.title = title;
        b.setAttribute('aria-label', title);
        b.disabled = disabled;
        b.onclick = fn;
        li.append(b);
      };
      mk('↑', 'Move up', () => {
        move(i - 1);
        status.textContent = `Moved ${f.name} up`;
      }, i === 0);
      mk('↓', 'Move down', () => {
        move(i + 1);
        status.textContent = `Moved ${f.name} down`;
      }, i === mergeFiles.length - 1);
      mk('✕', 'Remove', () => {
        mergeFiles.splice(i, 1);
        renderMerge();
        status.textContent = `Removed ${f.name}`;
      }, false);
      list.append(li);
    });
    const any = mergeFiles.length > 0;
    go.disabled = !any;
    opts.hidden = !any;
    actions.hidden = !any;
    hideDone(doneEl);
    err.hidden = true;
    status.textContent = any ? `${mergeFiles.length} file${mergeFiles.length === 1 ? '' : 's'} ready.` : '';
  }

  async function doMerge() {
    go.disabled = true;
    err.hidden = true;
    status.textContent = '';
    try {
      const parsed: { name: string; rows: string[][] }[] = [];
      for (const f of mergeFiles) {
        const text = (await f.text()).replace(/^﻿/, '');
        const res = Papa.parse<string[]>(text, { skipEmptyLines: true });
        parsed.push({ name: f.name, rows: res.data as string[][] });
      }
      const { rows: merged, differing } = mergeCsv(parsed, { addFileName: addName?.checked ?? false });
      if (merged.length <= 1) {
        err.textContent = 'No rows were found in those files.';
        err.hidden = false;
        return;
      }
      const csv = withBom(Papa.unparse(merged, { newline: '\r\n' }));
      const blob = new Blob([csv], { type: 'text/csv' });
      const again = () => save(blob, 'merged.csv');
      const result = new File([blob], 'merged.csv', { type: 'text/csv' });
      const warn = differing.length
        ? ` These files have different columns: ${differing.join(', ')}. Columns were matched by name; missing cells are left empty.`
        : '';
      status.textContent = `${merged.length - 1} rows from ${mergeFiles.length} files.${warn}`;
      again();
      showDone({ el: doneEl, slug: root.dataset.slug!, line: savedLine('merged.csv'), again, result });
    } catch {
      err.textContent = 'Those files could not be read as CSV.';
      err.hidden = false;
    } finally {
      go.disabled = mergeFiles.length === 0;
    }
  }

  drop.addEventListener('files', (e) => {
    const picked = [...(e as CustomEvent<File[]>).detail];
    if (!picked.length) return;
    if (merge) {
      mergeFiles.push(...picked);
      renderMerge();
    } else {
      showFile(picked[0]);
    }
  });

  go.addEventListener('click', async () => {
    if (merge) {
      await doMerge();
      return;
    }
    if (!file) return;
    const f = file;
    go.disabled = true;
    err.hidden = true;
    status.textContent = '';

    try {
      const bom = await hasBom(f);
      const base = baseName(f.name);
      let out: { name: string; data: Blob }[];
      let dataRows: number;
      if (mode() === 'column') {
        const column = Math.max(0, Number(colSel?.value) || 0);
        const res = await splitByValue(f, column, bom);
        dataRows = res.rows;
        out = res.parts.map((p) => ({
          name: valuePartName(base, p.value),
          data: new Blob([(bom ? BOM_CHAR : '') + p.csv], { type: 'text/csv' }),
        }));
      } else {
        let per: number;
        if (mode() === 'files') {
          status.textContent = 'Counting rows...';
          const total = await countRows(f);
          per = rowsPerPartFor(total, Math.max(1, Number(files.value) || 2));
        } else {
          per = Math.max(1, Math.floor(Number(rows.value) || 100000));
        }
        const { parts, rows: n } = await splitFile(f, per, bom);
        dataRows = n;
        out = parts.map((csv, i) => ({
          name: partName(base, i + 1, parts.length),
          data: new Blob([csv], { type: 'text/csv' }),
        }));
      }
      if (!out.length) {
        err.textContent = 'No rows were found in that file.';
        err.hidden = false;
        return;
      }

      let again: () => void;
      let line: string;
      let result: File | undefined;
      if (out.length === 1) {
        again = () => save(out[0].data, out[0].name);
        line = savedLine(out[0].name);
        result = new File([out[0].data], out[0].name, { type: 'text/csv' });
      } else {
        const zipped = await zip(out);
        again = () => save(zipped, `${base}-parts.zip`, 'application/zip');
        line = savedLine(`${base}-parts.zip`, out.length);
      }

      status.textContent = `${dataRows} rows into ${out.length} file${out.length === 1 ? '' : 's'}.`;
      again();
      showDone({ el: doneEl, slug: root.dataset.slug!, line, again, result });
    } catch (e) {
      err.textContent =
        e instanceof Error && e.message.startsWith('That column has')
          ? e.message
          : 'That file could not be read as CSV.';
      err.hidden = false;
    } finally {
      go.disabled = false;
    }
  });

  for (const r of document.querySelectorAll<HTMLInputElement>('input[name="mode"]')) {
    r.addEventListener('change', syncMode);
  }
  syncMode();
</script>
