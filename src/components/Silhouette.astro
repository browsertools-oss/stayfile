---
// Renders the painted shadow-board outline for each tool page. The shapes live in lib/silhouettes.ts.
interface Props { slug: string; class?: string }
import { shapes, S } from '../lib/silhouettes';
const { slug, class: cls } = Astro.props;
const layers = shapes[slug] ?? [S(36, 12, 48, 72)];
---
<svg class:list={['sil', cls]} viewBox="0 0 120 96" aria-hidden="true" focusable="false">
  {layers.map((s) => (
    <g>
      {s.tilt?.map((t) => <path d={t.d} transform={`rotate(${t.rot} ${t.cx} ${t.cy})`} />)}
      {s.fill.map((d) => <path d={d} />)}
      {s.dots?.map((c) => <circle class="dot" cx={c.cx} cy={c.cy} r={c.r} />)}
      {s.cut.map((d) => <path class="cut" d={d} />)}
      {s.ink?.map((d) => <path class="ink" d={d} />)}
    </g>
  ))}
</svg>
