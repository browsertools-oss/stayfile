---
import Base from '../layouts/Base.astro';
import PdfTool from './PdfTool.astro';
import ImageTool from './ImageTool.astro';
import DataTool from './DataTool.astro';
import { SITE, PAGES, GROUP_ID, type ToolPage } from '../site';
interface Props { page: ToolPage }
const { page } = Astro.props;
const path = `/${page.slug}/`;
const family = page.tool.startsWith('pdf') || page.tool === 'img-to-pdf' ? 'pdf' : page.tool.startsWith('img') ? 'img' : 'data';
const related = PAGES.filter((p) => p.group === page.group && p.slug !== page.slug);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${page.h1} | ${SITE.name}`,
    url: new URL(path, SITE.url).href,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: new URL('/', SITE.url).href },
      { '@type': 'ListItem', position: 2, name: page.h1, item: new URL(path, SITE.url).href },
    ],
  },
];
---
<Base title={page.title} description={page.description} path={path} jsonld={jsonld}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">{SITE.name}</a><span aria-hidden="true">/</span><a href={`/#${GROUP_ID[page.group]}`}>{page.group}</a></nav>
  <h1>{page.h1}</h1>
  <p class="lede">{page.lede}</p>
  {family === 'pdf' && <PdfTool tool={page.tool} preset={page.preset} />}
  {family === 'img' && <ImageTool tool={page.tool} preset={page.preset} />}
  {family === 'data' && <DataTool tool={page.tool} />}
  <section class="row first">
    <h2>How to use it</h2>
    <ol class="steps">{page.steps.map((s) => <li>{s}</li>)}</ol>
  </section>
  <section class="row">
    <h2>Questions</h2>
    <div>{page.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </section>
  {related.length > 0 && (
    <section class="row">
      <h2>Other {page.group === 'Spreadsheets and data' ? 'data' : page.group === 'PDF' ? 'PDF' : 'image'} tools</h2>
      <p class="related">{related.map((p) => <a href={`/${p.slug}/`}>{p.card}</a>)}</p>
    </section>
  )}
</Base>
<style>
  .crumbs { display: flex; gap: 8px; margin-top: 32px; font-size: 14px; color: var(--muted); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs + h1 { margin-top: 8px; }
  .lede { margin-bottom: 24px; }
  .first { margin-top: 48px; }
  @media (max-width: 640px) { .first { margin-top: 32px; } }
  .related { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .related a { display: inline-flex; align-items: center; height: 40px; padding: 0 16px; border: 1px solid var(--line-strong); text-decoration: none; color: var(--ink); font-size: 14px; }
  .related a:hover { background: var(--layer); border-color: var(--accent); color: var(--ink); }
  details:first-of-type { border-top: 0; }
  details:first-of-type summary { padding-top: 2px; min-height: 0; padding-bottom: 12px; }
</style>
