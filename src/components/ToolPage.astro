---
import Base from '../layouts/Base.astro';
import PdfTool from './PdfTool.astro';
import ImageTool from './ImageTool.astro';
import DataTool from './DataTool.astro';
import { SITE, PAGES, type ToolPage } from '../site';
interface Props { page: ToolPage }
const { page } = Astro.props;
const path = `/${page.slug}/`;
const family = page.tool.startsWith('pdf') || page.tool === 'img-to-pdf' ? 'pdf' : page.tool.startsWith('img') ? 'img' : 'data';
const related = PAGES.filter((p) => p.group === page.group && p.slug !== page.slug);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${page.h1} | ${SITE.name}`,
    url: new URL(path, SITE.url).href,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: new URL('/', SITE.url).href },
      { '@type': 'ListItem', position: 2, name: page.h1, item: new URL(path, SITE.url).href },
    ],
  },
];
---
<Base title={page.title} description={page.description} path={path} jsonld={jsonld}>
  <h1>{page.h1}</h1>
  <p class="lede">{page.lede}</p>
  {family === 'pdf' && <PdfTool tool={page.tool} preset={page.preset} />}
  {family === 'img' && <ImageTool tool={page.tool} preset={page.preset} />}
  {family === 'data' && <DataTool tool={page.tool} />}
  <h2>How to use it</h2>
  <ol class="steps">{page.steps.map((s) => <li>{s}</li>)}</ol>
  <h2>Questions</h2>
  {page.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  {related.length > 0 && (
    <>
      <h2>Other {page.group === 'Spreadsheets and data' ? 'data' : page.group === 'PDF' ? 'PDF' : 'image'} tools</h2>
      <p class="related">{related.map((p) => <a href={`/${p.slug}/`}>{p.card}</a>)}</p>
    </>
  )}
</Base>
<style>
  .related { display: flex; flex-wrap: wrap; gap: 8px; }
  .related a { border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; text-decoration: none; color: var(--ink); font-size: 14px; }
  .related a:hover { border-color: var(--accent); color: var(--accent); }
</style>
