---
import Base from '../layouts/Base.astro';
import PdfTool from './PdfTool.astro';
import ImageTool from './ImageTool.astro';
import DataTool from './DataTool.astro';
import CalendarTool from './CalendarTool.astro';
import ContactsTool from './ContactsTool.astro';
import PhotoMetaTool from './PhotoMetaTool.astro';
import Silhouette from './Silhouette.astro';
import { SITE, PAGES, GROUP_ID, GUIDES, type ToolPage } from '../site';
import { formatsFor } from '../formats';
interface Props { page: ToolPage }
const { page } = Astro.props;
const guides = [page.guide].flat().filter(Boolean).map((slug) => GUIDES.find((g) => g.slug === slug)).filter((g): g is NonNullable<typeof g> => Boolean(g));
const path = `/${page.slug}/`;
const formats = formatsFor(page.slug);
const FACT_ROWS: [keyof (typeof formats)[number]['facts'], string][] = [
  ['kind', 'What it is'],
  ['since', 'Dates from'],
  ['by', 'Made by'],
  ['goodFor', 'Good for'],
  ['watch', 'Watch out for'],
  ['opens', 'Opens in'],
];
const family = page.tool === 'photo-meta' ? 'meta' : page.tool === 'csv-to-vcf' || page.tool === 'vcf-to-csv' ? 'contacts' : page.tool === 'csv-to-ics' || page.tool === 'ics-to-csv' ? 'cal' : page.tool.startsWith('pdf') || page.tool === 'img-to-pdf' || page.tool === 'text-to-pdf' ? 'pdf' : page.tool.startsWith('img') ? 'img' : 'data';
// Show the pages that share a format with this one, then the rest, capped at eight so a
// twenty-card group does not bury the page under its own related list.
const STOP = new Set(['to', 'from', 'a', 'the']);
const tokens = new Set(page.slug.split('-').filter((t) => !STOP.has(t)));
const related = PAGES.filter((p) => p.group === page.group && p.slug !== page.slug)
  .map((p, i) => ({ p, i, s: p.slug.split('-').filter((t) => tokens.has(t)).length }))
  .sort((a, b) => b.s - a.s || a.i - b.i)
  .slice(0, 8)
  .map((x) => x.p);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${page.h1} | ${SITE.name}`,
    url: new URL(path, SITE.url).href,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: new URL('/', SITE.url).href },
      { '@type': 'ListItem', position: 2, name: page.h1, item: new URL(path, SITE.url).href },
    ],
  },
];
---
<Base title={page.title} description={page.description} path={path} jsonld={jsonld}>
  <div class="board bleed band" data-family={family}>
    <div class="wall">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">{SITE.name}</a><span aria-hidden="true">/</span><a href={`/#${GROUP_ID[page.group]}`}>{page.group}</a></nav>
      <div class="head">
        <div>
          <h1>{page.h1}</h1>
          <p class="lede">{page.lede}</p>
        </div>
        <Silhouette slug={page.slug} class="mark-big" />
      </div>
      {family === 'pdf' && <PdfTool tool={page.tool} preset={page.preset} slug={page.slug} />}
      {family === 'img' && <ImageTool tool={page.tool} preset={page.preset} slug={page.slug} />}
      {family === 'data' && <DataTool tool={page.tool} slug={page.slug} preset={page.preset} />}
      {family === 'cal' && <CalendarTool tool={page.tool} slug={page.slug} />}
      {family === 'contacts' && <ContactsTool tool={page.tool} slug={page.slug} />}
      {family === 'meta' && <PhotoMetaTool slug={page.slug} />}
    </div>
  </div>
  <aside class="ad-slot" aria-hidden="true" data-ad-slot></aside>
  <section class="row first">
    <h2>How to use it</h2>
    <ol class="steps">{page.steps.map((s) => <li>{s}</li>)}</ol>
  </section>
  {page.more && (
    <section class="row">
      <h2>{page.more.h2}</h2>
      <div>
        {page.more.paras.map((p) => <p>{p}</p>)}
        {page.more.sample && (
          <div class="samples">
            <div><span class="sample-label">Before</span><pre class="sample">{page.more.sample.before}</pre></div>
            <div><span class="sample-label">After</span><pre class="sample">{page.more.sample.after}</pre></div>
          </div>
        )}
      </div>
    </section>
  )}
  {formats.length > 0 && (
    <section class="row">
      <h2>{formats.length === 1 ? `About ${formats[0].name} files` : `${formats.map((f) => f.name).join(' and ')} compared`}</h2>
      <div>
        <div class="fmt-wrap">
          <table class="fmt">
            {formats.length > 1 && <thead><tr><th scope="col"><span class="vh">Fact</span></th>{formats.map((f) => <th scope="col">{f.name}</th>)}</tr></thead>}
            <tbody>
              {FACT_ROWS.map(([k, label]) => <tr><th scope="row">{label}</th>{formats.map((f) => <td>{f.facts[k]}</td>)}</tr>)}
            </tbody>
          </table>
        </div>
        {formats.map((f) => (
          <>
            <h3 class="fmt-h">{f.name}: {f.full}</h3>
            {f.paras.map((p) => <p>{p}</p>)}
          </>
        ))}
      </div>
    </section>
  )}
  <section class="row">
    <h2>Questions</h2>
    <div>{page.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    {guides.map((g) => <p class="read-guide">Read the guide: <a href={`/guides/${g.slug}/`}>{g.title}</a></p>)}
  </section>
  {related.length > 0 && (
    <section class="row">
      <h2>Other {page.group === 'Spreadsheets and data' ? 'data' : page.group === 'PDF' ? 'PDF' : 'image'} tools</h2>
      <ul class="related">{related.map((p) => <li><a href={`/${p.slug}/`}><Silhouette slug={p.slug} /><span>{p.card}</span></a></li>)}</ul>
    </section>
  )}
</Base>
<style>
  .band { padding-bottom: 40px; }
  .crumbs { display: flex; gap: 8px; align-items: center; padding-top: 28px; font-size: 14px; font-weight: 600; color: var(--paint-muted); }
  .crumbs a { color: var(--paint); text-decoration: none; }
  .crumbs a:hover { color: #ffffff; text-decoration: underline; }
  .head { display: grid; grid-template-columns: minmax(0, 1fr) 200px; gap: 24px; align-items: end; }
  .head h1 { margin-top: 12px; }
  .head .lede { margin-bottom: 28px; }
  .head :global(.mark-big) { width: 200px; margin-bottom: 24px; color: var(--paint); }
  .first { border-top: 0; }
  .fmt-wrap { overflow-x: auto; margin-bottom: 8px; }
  .fmt { border-collapse: collapse; width: 100%; font-size: 15px; }
  .fmt th, .fmt td { text-align: left; vertical-align: top; padding: 8px 12px 8px 0; border-bottom: 1px solid var(--line); }
  .fmt tbody th { font-weight: 700; color: var(--muted); white-space: nowrap; width: 1%; }
  .fmt thead th { font-weight: 800; }
  .fmt-h { margin-top: 24px; font-size: 18px; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .read-guide { margin-top: 12px; font-size: 15px; }
  .samples { display: grid; gap: 12px; margin-top: 8px; }
  .sample-label { display: block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 4px; }
  .sample { font-family: var(--mono); font-size: 12px; overflow-x: auto; background: var(--field); border: 1px solid var(--line); border-radius: var(--r); padding: 10px 12px; margin: 0; }
  .related { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(124px, 1fr)); gap: 12px; }
  .related a { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 12px 8px; border-radius: var(--r); color: var(--board); text-decoration: none; font-size: 14px; font-weight: 700; text-align: center; }
  .related a :global(.sil) { width: 100%; max-width: 104px; --cut: var(--ground); }
  .related a span { color: var(--ink); }
  .related a:hover { background: var(--tray); --ground: var(--tray); }
  details:first-of-type summary { padding-top: 0; min-height: 0; padding-bottom: 12px; }
  @media (max-width: 760px) {
    .head { grid-template-columns: 1fr; }
    .head :global(.mark-big) { display: none; }
    .related { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
