---
import Base from '../layouts/Base.astro';
import PdfTool from './PdfTool.astro';
import ImageTool from './ImageTool.astro';
import DataTool from './DataTool.astro';
import Silhouette from './Silhouette.astro';
// avoid-ai-design-ignore-file: K7 (every :focus-visible rule lives in src/styles/site.css, loaded by Base.astro)
import { SITE, PAGES, GROUP_ID, type ToolPage } from '../site';
interface Props { page: ToolPage }
const { page } = Astro.props;
const path = `/${page.slug}/`;
const family = page.tool.startsWith('pdf') || page.tool === 'img-to-pdf' ? 'pdf' : page.tool.startsWith('img') ? 'img' : 'data';
const related = PAGES.filter((p) => p.group === page.group && p.slug !== page.slug);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${page.h1} | ${SITE.name}`,
    url: new URL(path, SITE.url).href,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: new URL('/', SITE.url).href },
      { '@type': 'ListItem', position: 2, name: page.h1, item: new URL(path, SITE.url).href },
    ],
  },
];
---
<Base title={page.title} description={page.description} path={path} jsonld={jsonld}>
  <div class="board bleed band" data-family={family}>
    <div class="wall">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">{SITE.name}</a><span aria-hidden="true">/</span><a href={`/#${GROUP_ID[page.group]}`}>{page.group}</a></nav>
      <div class="head">
        <div>
          <h1>{page.h1}</h1>
          <p class="lede">{page.lede}</p>
        </div>
        <Silhouette slug={page.slug} class="mark-big" />
      </div>
      {family === 'pdf' && <PdfTool tool={page.tool} preset={page.preset} slug={page.slug} />}
      {family === 'img' && <ImageTool tool={page.tool} preset={page.preset} slug={page.slug} />}
      {family === 'data' && <DataTool tool={page.tool} slug={page.slug} />}
    </div>
  </div>
  <aside class="ad-slot" aria-hidden="true" data-ad-slot></aside>
  <section class="row first">
    <h2>How to use it</h2>
    <ol class="steps">{page.steps.map((s) => <li>{s}</li>)}</ol>
  </section>
  <section class="row">
    <h2>Questions</h2>
    <div>{page.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </section>
  {related.length > 0 && (
    <section class="row">
      <h2>Other {page.group === 'Spreadsheets and data' ? 'data' : page.group === 'PDF' ? 'PDF' : 'image'} tools</h2>
      <ul class="related">{related.map((p) => <li><a href={`/${p.slug}/`}><Silhouette slug={p.slug} /><span>{p.card}</span></a></li>)}</ul>
    </section>
  )}
</Base>
<style>
  .band { padding-bottom: var(--space-2xl); }
  .crumbs { display: flex; gap: var(--space-xs); align-items: center; padding-top: var(--space-lg); font-size: var(--text-sm); font-weight: 400; color: var(--color-ink-2); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .head { display: grid; grid-template-columns: minmax(0, 1fr) 180px; gap: var(--space-lg); align-items: end; }
  .head h1 { margin-top: var(--space-sm); text-wrap: balance; }
  .head .lede { margin-bottom: var(--space-lg); }
  .head :global(.mark-big) { width: 180px; margin-bottom: var(--space-lg); color: var(--color-ink); --cut: var(--color-paper-2); }
  .first { border-top-width: var(--rule-bar); }
  .related { list-style: none; margin: 0; padding: 0 1px 1px 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); }
  .related li { border: var(--rule-hair) solid var(--color-ink); margin: 0 -1px -1px 0; }
  .related a { display: flex; flex-direction: column; align-items: center; gap: var(--space-xs); height: 100%; padding: var(--space-md) var(--space-xs); color: var(--color-ink); text-decoration: none; font-size: var(--text-sm); font-weight: 600; text-align: center; --cut: var(--color-paper); }
  .related a :global(.sil) { width: 100%; max-width: 96px; }
  .related a:hover { background: var(--color-paper-2); --cut: var(--color-paper-2); }
  .related a:hover span { text-decoration: underline; text-underline-offset: 0.25em; }
  details:first-of-type summary { padding-top: 0; min-height: 0; padding-bottom: var(--space-sm); }
  @media (max-width: 760px) {
    .head { grid-template-columns: 1fr; }
    .head :global(.mark-big) { display: none; }
    .related { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
