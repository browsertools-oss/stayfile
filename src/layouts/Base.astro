---
// avoid-ai-design-ignore-file: K7 (every :focus-visible rule lives in src/styles/site.css, loaded on every page here)
import { SITE, PAGES, GROUPS, GROUP_ID, GROUP_SHORT } from '../site';
import '../styles/site.css';
interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object[];
}
const { title, description, path, jsonld = [] } = Astro.props;
const canonical = new URL(path, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="theme-color" content="#a39f98" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#25262a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/overpass-var.woff2" as="font" type="font/woff2" crossorigin />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="bar">
        <a class="brand" href="/">
          <svg class="mark" viewBox="8 8 17 22" aria-hidden="true"><path d="M9 9h10l5 5v15H9z" class="sheet" /><path d="M19 9v5h5" class="fold" /></svg>
          <span class="tape">{SITE.name}</span>
        </a>
        <nav class="sections" aria-label="Tool groups">
          {GROUPS.map((g) => <a href={`/#${GROUP_ID[g]}`}>{GROUP_SHORT[g]}</a>)}
        </nav>
        <span class="local"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 7h10v7H3zM5 7V5a3 3 0 0 1 6 0v2" /></svg>Files stay on this device</span>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="foot">
        <div class="cols">
          {GROUPS.map((g) => (
            <nav aria-label={`${g} tools`}>
              <h3>{g}</h3>
              {PAGES.filter((p) => p.group === g).map((p) => <a href={`/${p.slug}/`}>{p.card}</a>)}
            </nav>
          ))}
        </div>
        <p>
          <span>{SITE.name} works in your browser and never uploads your files.</span> <a href="/privacy/">Privacy</a> <a href="/about/">About</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* the Floor, repeated where the document is built: no sideways scroll at any width */
  html, body { overflow-x: clip; }
</style>
