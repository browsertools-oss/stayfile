---
import { SITE, PAGES, GROUPS, GROUP_ID, GROUP_SHORT } from '../site';
interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object[];
}
const { title, description, path, jsonld = [] } = Astro.props;
const canonical = new URL(path, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/ibm-plex-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="bar">
        <a class="brand" href="/">
          <svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" /><path d="M10 7h8l5 5v13H10z" class="sheet" /><path d="M18 7v5h5" class="fold" /></svg>
          {SITE.name}
        </a>
        <nav class="sections" aria-label="Tool groups">
          {GROUPS.map((g) => <a href={`/#${GROUP_ID[g]}`}>{GROUP_SHORT[g]}</a>)}
        </nav>
        <span class="local">Files stay on this device</span>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="foot">
        <div class="cols">
          {GROUPS.map((g) => (
            <nav aria-label={`${g} tools`}>
              <h3>{g}</h3>
              {PAGES.filter((p) => p.group === g).map((p) => <a href={`/${p.slug}/`}>{p.card}</a>)}
            </nav>
          ))}
        </div>
        <p>
          {SITE.name} works in your browser and never uploads your files. <a href="/privacy/">Privacy</a> · <a href="/about/">About</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /*
    Tokens follow IBM's Carbon Design System (white theme for light, Gray 100 for dark):
    square corners, 1px hairlines, a 4px grid, IBM Plex Sans with light-weight display type.
    The accent is Carbon's own green ramp (green 60/70/80, green 40/30 on dark) instead of
    Carbon blue, to keep Stayfile's existing green. See DESIGN.md.
  */
  @font-face {
    font-family: 'IBM Plex Sans';
    font-style: normal;
    font-weight: 100 700;
    font-display: swap;
    src: url('/fonts/ibm-plex-sans-var.woff2') format('woff2-variations'), url('/fonts/ibm-plex-sans-var.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  :root {
    --bg: #ffffff;
    --layer: #f4f4f4;
    --layer-hover: #e8e8e8;
    --field: #ffffff;
    --drop: #ffffff;
    --line: #e0e0e0;
    --line-strong: #8d8d8d;
    --ink: #161616;
    --muted: #525252;
    --helper: #6f6f6f;
    --accent: #198038;
    --accent-hover: #0e6027;
    --accent-press: #044317;
    --on-accent: #ffffff;
    --link: #198038;
    --link-hover: #0e6027;
    --btn2: #393939;
    --btn2-hover: #474747;
    --selected: #161616;
    --on-selected: #ffffff;
    --head: #e0e0e0;
    --focus: #198038;
    --ok: #198038;
    --bad: #da1e28;
    --sans: 'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif;
    --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    --wrap: 1120px;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161616;
      --layer: #262626;
      --layer-hover: #333333;
      --field: #393939;
      --drop: #161616;
      --line: #393939;
      --line-strong: #6f6f6f;
      --ink: #f4f4f4;
      --muted: #c6c6c6;
      --helper: #a8a8a8;
      --accent: #198038;
      --accent-hover: #0e6027;
      --accent-press: #044317;
      --on-accent: #ffffff;
      --link: #42be65;
      --link-hover: #6fdc8c;
      --btn2: #6f6f6f;
      --btn2-hover: #5e5e5e;
      --selected: #f4f4f4;
      --on-selected: #161616;
      --head: #393939;
      --focus: #ffffff;
      --ok: #42be65;
      --bad: #ff8389;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 400 16px/1.5 var(--sans);
    letter-spacing: 0.16px;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--link); text-underline-offset: 3px; }
  a:hover { color: var(--link-hover); }
  .skip { position: absolute; left: 16px; top: -48px; background: var(--accent); color: var(--on-accent); padding: 12px 16px; z-index: 10; }
  .skip:focus { top: 0; }

  /* header: 48px bar with hairline, Carbon UI shell proportions */
  .top { border-bottom: 1px solid var(--line); background: var(--bg); }
  .bar, main, .foot { max-width: var(--wrap); margin: 0 auto; padding: 0 16px; }
  .bar { display: flex; align-items: stretch; height: 48px; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px; color: var(--ink); text-decoration: none; }
  .brand:hover { color: var(--ink); }
  .mark { width: 24px; height: 24px; fill: var(--accent); }
  .mark .sheet { fill: #ffffff; }
  .mark .fold { fill: #a7f0ba; }
  .sections { display: flex; align-items: stretch; }
  .sections a { display: flex; align-items: center; padding: 0 14px; font-size: 14px; color: var(--muted); text-decoration: none; border-bottom: 2px solid transparent; }
  .sections a:hover { color: var(--ink); background: var(--layer); border-bottom-color: var(--accent); }
  .local { margin-left: auto; align-self: center; font-size: 12px; letter-spacing: 0.32px; color: var(--muted); }
  @media (max-width: 640px) {
    .bar { gap: 8px; }
    .sections a { padding: 0 10px; }
    .local { display: none; }
  }

  /* type: Carbon ramp, light display weight */
  h1 { font-size: 42px; font-weight: 300; line-height: 1.2; letter-spacing: 0; margin: 40px 0 12px; max-width: 22ch; text-wrap: balance; }
  h2 { font-size: 20px; font-weight: 400; line-height: 1.4; margin: 0 0 12px; }
  h3 { font-size: 14px; font-weight: 600; line-height: 1.29; margin: 0; }
  .lede { color: var(--muted); font-size: 18px; line-height: 1.5; max-width: 60ch; margin: 0 0 32px; text-wrap: pretty; letter-spacing: 0; }
  main > p { max-width: 68ch; }
  main > h2 { margin-top: 40px; }
  @media (max-width: 640px) {
    h1 { font-size: 32px; line-height: 1.25; margin-top: 28px; }
    .lede { font-size: 16px; margin-bottom: 24px; }
  }

  /* label column + content column, used by the home index and the tool page sections */
  .row { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 0 32px; border-top: 1px solid var(--line); padding: 20px 0 32px; }
  .row > h2 { margin: 0; }
  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr; padding: 16px 0 24px; }
    .row > h2 { margin-bottom: 12px; }
  }

  ol.steps { padding: 0; margin: 0; list-style: none; counter-reset: s; }
  ol.steps li { counter-increment: s; display: grid; grid-template-columns: 32px 1fr; padding: 10px 0; border-bottom: 1px solid var(--line); }
  ol.steps li:first-child { padding-top: 2px; }
  ol.steps li:last-child { border-bottom: 0; }
  ol.steps li::before { content: counter(s); font-weight: 600; color: var(--link); font-variant-numeric: tabular-nums; }

  /* accordion */
  details { border-bottom: 1px solid var(--line); }
  details:first-of-type { border-top: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 16px 12px 0; min-height: 48px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ''; flex: none; width: 8px; height: 8px; border-right: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink); transform: translateY(-2px) rotate(45deg); transition: transform .11s cubic-bezier(.2, 0, .38, .9); }
  details[open] summary::after { transform: translateY(2px) rotate(-135deg); }
  summary:hover { background: var(--layer); }
  details p { color: var(--muted); margin: 0; padding: 0 16px 20px 0; max-width: 64ch; }

  footer { margin-top: 64px; background: var(--layer); border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }
  footer .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px 32px; padding: 32px 0 24px; }
  footer nav { display: flex; flex-direction: column; gap: 6px; }
  footer h3 { color: var(--ink); margin-bottom: 6px; }
  footer nav a { color: var(--muted); text-decoration: none; }
  footer nav a:hover { color: var(--ink); text-decoration: underline; }
  footer p { margin: 0; padding: 16px 0 32px; border-top: 1px solid var(--line); }

  /* tool shell, shared by all tools: a Carbon layer-01 tile with fields on the next layer */
  .tool { background: var(--layer); padding: 16px; }
  .drop { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; min-height: 220px; border: 1px dashed var(--line-strong); background: var(--drop); cursor: pointer; text-align: center; padding: 24px 16px; transition: background-color .11s cubic-bezier(.2, 0, .38, .9), border-color .11s; }
  .drop:hover, .drop.over { border: 2px solid var(--accent); padding: 23px 15px; }
  .drop.over { background: color-mix(in srgb, var(--accent) 8%, var(--drop)); }
  .drop.compact { min-height: 0; flex-direction: row; justify-content: flex-start; gap: 12px; padding: 12px 16px; }
  .drop.compact:hover, .drop.compact.over { padding: 11px 15px; }
  .drop-main { font-size: 20px; font-weight: 400; line-height: 1.4; }
  .drop.compact .drop-main { font-size: 14px; }
  .drop-main u { color: var(--link); text-decoration: none; border-bottom: 1px solid currentColor; }
  .drop-sub { color: var(--muted); font-size: 14px; }
  @media (max-width: 640px) {
    .tool { padding: 12px; }
    .drop { min-height: 168px; }
    .drop-main { font-size: 18px; }
    .drop.compact .drop-sub { display: none; }
    .files li { row-gap: 4px; }
    .files .name { flex: 1 1 calc(100% - 64px); }
    .files .meta { margin-right: auto; }
    /* Image rows: thumb, name, Save and remove on one line; sizes on the line below, under the name. */
    .files li:has(.thumb) .name { flex: 1 1 0; min-width: 0; }
    .files li:has(.thumb) .meta { order: 9; flex-basis: 100%; padding-left: 52px; }
  }
  .drop.compact .drop-sub { font-size: 12px; }
  .files { list-style: none; margin: 0 0 16px; padding: 0; background: var(--field); }
  .files:empty { display: none; }
  .files li { display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 8px 8px 8px 16px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .files li:last-child { border-bottom: 0; }
  .files .n { font-size: 12px; color: var(--muted); width: 2ch; text-align: right; font-variant-numeric: tabular-nums; }
  .files .name { flex: 1 1 200px; word-break: break-all; font-size: 14px; }
  .files .meta { font-family: var(--mono); font-size: 12px; letter-spacing: 0; color: var(--muted); }
  .files .ok { color: var(--ok); }
  .files .warn { color: var(--bad); }
  .files .thumb { width: 40px; height: 40px; object-fit: cover; border: 1px solid var(--line); background: var(--layer); }
  .icon { font: inherit; font-size: 14px; line-height: 1; min-width: 32px; height: 32px; background: transparent; color: var(--ink); border: 0; padding: 0 8px; cursor: pointer; }
  .icon:hover:not(:disabled) { background: var(--layer-hover); }
  .icon:disabled { opacity: .3; cursor: default; }
  .opts { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-end; padding: 16px 0; }
  .opts label { display: flex; flex-direction: column; gap: 8px; font-size: 12px; letter-spacing: 0.32px; color: var(--muted); }
  .opts label.check { flex-direction: row; align-items: center; gap: 8px; font-size: 14px; letter-spacing: 0.16px; color: var(--ink); min-height: 40px; }
  .opts .full { width: 100%; }
  .hint { width: 100%; color: var(--helper); font-size: 12px; letter-spacing: 0.32px; margin: 0; }
  .seg { display: inline-flex; flex-wrap: wrap; }
  .seg label { flex-direction: row !important; gap: 0 !important; font-size: 14px !important; letter-spacing: 0.16px !important; }
  .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { display: flex; align-items: center; height: 40px; padding: 0 16px; cursor: pointer; color: var(--muted); border: 1px solid var(--line-strong); margin-left: -1px; background: transparent; }
  .seg label:first-child span { margin-left: 0; }
  .seg span:hover { background: var(--layer-hover); color: var(--ink); }
  .seg input:checked + span { background: var(--selected); color: var(--on-selected); border-color: var(--selected); position: relative; }
  .seg input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: -2px; position: relative; }
  input[type='text'], input[type='number'], input:not([type]), select, textarea { font: inherit; font-size: 14px; color: var(--ink); background: var(--field); border: 0; border-bottom: 1px solid var(--line-strong); border-radius: 0; height: 40px; padding: 0 16px; min-width: 0; }
  select { padding-right: 40px; appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%), linear-gradient(135deg, var(--ink) 50%, transparent 50%); background-position: calc(100% - 20px) 18px, calc(100% - 15px) 18px; background-size: 5px 5px; background-repeat: no-repeat; }
  input[type='number'] { width: 120px; }
  input[type='range'] { accent-color: var(--accent); width: 180px; vertical-align: middle; }
  input[type='checkbox'] { accent-color: var(--accent); width: 16px; height: 16px; margin: 0; }
  ::placeholder { color: var(--helper); opacity: 1; }
  textarea { width: 100%; height: auto; padding: 11px 16px; font-family: var(--mono); font-size: 13px; letter-spacing: 0; line-height: 1.5; resize: vertical; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  button:focus-visible, a:focus-visible, .drop:focus-within { outline: 2px solid var(--focus); outline-offset: 2px; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; padding-top: 16px; border-top: 1px solid var(--line); }
  .primary, .secondary { font: inherit; font-size: 14px; letter-spacing: 0.16px; height: 48px; padding: 0 64px 0 16px; text-align: left; border: 0; border-radius: 0; cursor: pointer; transition: background-color .07s cubic-bezier(0, 0, .38, .9); }
  .primary { background: var(--accent); color: var(--on-accent); }
  .primary:hover:not(:disabled) { background: var(--accent-hover); }
  .primary:active:not(:disabled) { background: var(--accent-press); }
  .primary:disabled, .secondary:disabled { background: var(--line); color: var(--helper); cursor: not-allowed; }
  .secondary { background: var(--btn2); color: #ffffff; padding-right: 32px; }
  .secondary:hover:not(:disabled) { background: var(--btn2-hover); }
  .link { font: inherit; font-size: 14px; background: none; border: 0; height: 48px; padding: 0 16px; color: var(--link); cursor: pointer; }
  .link:hover { background: var(--layer-hover); color: var(--link-hover); }
  .status { font-size: 14px; color: var(--muted); }
  .error { color: var(--bad); font-size: 14px; margin: 12px 0 0; padding-left: 12px; border-left: 3px solid var(--bad); }
  .preview { margin-top: 16px; overflow: auto; max-height: 360px; background: var(--field); }
  table { border-collapse: collapse; width: 100%; font-size: 14px; }
  th { position: sticky; top: 0; background: var(--head); text-align: left; color: var(--ink); font-weight: 600; padding: 0 16px; height: 40px; white-space: nowrap; }
  td { border-bottom: 1px solid var(--line); padding: 8px 16px; vertical-align: top; white-space: nowrap; max-width: 280px; overflow: hidden; text-overflow: ellipsis; font-family: var(--mono); font-size: 13px; letter-spacing: 0; color: var(--muted); }
  [hidden] { display: none !important; }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
