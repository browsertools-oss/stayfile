---
import { SITE, PAGES, GROUPS } from '../site';
interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object[];
}
const { title, description, path, jsonld = [] } = Astro.props;
const canonical = new URL(path, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="theme-color" content="#eef2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1613" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/">
        <svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" /><path d="M10 7h8l5 5v13H10z" class="sheet" /><circle cx="16.5" cy="19" r="3" /></svg>
        {SITE.name}
      </a>
      <span class="local"><span class="dot" aria-hidden="true"></span>Files stay on this device</span>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="cols">
        {GROUPS.map((g) => (
          <nav aria-label={`${g} tools`}>
            <h3>{g}</h3>
            {PAGES.filter((p) => p.group === g).map((p) => <a href={`/${p.slug}/`}>{p.card}</a>)}
          </nav>
        ))}
      </div>
      <p>
        {SITE.name} works in your browser and never uploads your files. <a href="/privacy/">Privacy</a> · <a href="/about/">About</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #eef2ec;
    --card: #fbfcfa;
    --ink: #10201a;
    --muted: #55655d;
    --line: #d5ddd6;
    --accent: #0d5c46;
    --accent-ink: #f2f5ef;
    --soft: #dfeae2;
    --sheet: #f2f5ef;
    --ok: #0d7a4f;
    --bad: #a3271b;
    --radius: 6px;
    --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1613;
      --card: #16201b;
      --ink: #e4ece6;
      --muted: #93a39a;
      --line: #27342d;
      --accent: #5fd0a2;
      --accent-ink: #08130e;
      --soft: #1c2b24;
      --sheet: #16201b;
      --ok: #5fd0a2;
      --bad: #ff8f80;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  a { color: var(--accent); text-underline-offset: 2px; }
  main, .top, footer { max-width: 920px; margin: 0 auto; padding: 0 16px; }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 18px; padding-bottom: 18px; flex-wrap: wrap; border-bottom: 1px solid var(--line); }
  .brand { display: inline-flex; align-items: center; gap: 8px; font-family: ui-rounded, 'SF Pro Rounded', system-ui, sans-serif; font-weight: 700; font-size: 19px; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
  .mark { width: 26px; height: 26px; fill: var(--accent); }
  .mark .sheet { fill: var(--sheet); }
  .local { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; color: var(--muted); font-family: var(--mono); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent); }
  h1, h2, h3 { font-family: ui-rounded, 'SF Pro Rounded', system-ui, sans-serif; }
  h1 { font-size: clamp(30px, 5.4vw, 44px); line-height: 1.08; letter-spacing: -0.025em; margin: 44px 0 12px; text-wrap: balance; }
  .lede { color: var(--muted); font-size: 18px; max-width: 62ch; margin: 0 0 28px; text-wrap: pretty; }
  h2 { font-size: 21px; margin: 52px 0 12px; letter-spacing: -0.01em; }
  ol.steps { padding: 0; margin: 0; list-style: none; counter-reset: s; display: grid; gap: 10px; }
  ol.steps li { counter-increment: s; display: grid; grid-template-columns: 30px 1fr; gap: 10px; align-items: baseline; }
  ol.steps li::before { content: counter(s); font-family: var(--mono); font-size: 13px; color: var(--accent); border: 1px solid var(--line); border-radius: var(--radius); text-align: center; line-height: 24px; height: 26px; }
  details { border-top: 1px solid var(--line); padding: 14px 0; }
  details:last-of-type { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; font-weight: 600; }
  details p { color: var(--muted); margin: 8px 0 0; max-width: 68ch; }
  footer { margin-top: 72px; padding-bottom: 40px; color: var(--muted); font-size: 14px; border-top: 1px solid var(--line); }
  footer .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; padding: 24px 0 8px; }
  footer nav { display: flex; flex-direction: column; gap: 4px; }
  footer h3 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink); margin: 0 0 4px; }
  footer nav a { color: var(--muted); text-decoration: none; }
  footer nav a:hover { color: var(--ink); text-decoration: underline; }

  /* tool shell, shared by all tools */
  .tool { background: var(--card); border: 1px solid var(--line); border-radius: calc(var(--radius) * 2); padding: 16px; box-shadow: 0 1px 0 var(--line), 0 12px 32px -24px rgb(16 32 26 / 0.35); }
  .drop { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; min-height: 190px; border: 1.5px dashed color-mix(in srgb, var(--accent) 45%, var(--line)); border-radius: var(--radius); cursor: pointer; text-align: center; padding: 24px; background: repeating-linear-gradient(135deg, transparent 0 10px, color-mix(in srgb, var(--soft) 55%, transparent) 10px 11px); transition: background-color .15s, border-color .15s; }
  .drop:hover, .drop.over { background-color: var(--soft); border-color: var(--accent); }
  .drop.compact { min-height: 0; flex-direction: row; padding: 12px; }
  .drop-main { font-size: 18px; font-weight: 600; }
  .drop.compact .drop-main { font-size: 15px; }
  .drop-main u { color: var(--accent); text-underline-offset: 3px; }
  .drop-sub { color: var(--muted); font-size: 13px; font-family: var(--mono); }
  .files { list-style: none; margin: 0 0 12px; padding: 0; border: 1px solid var(--line); border-radius: var(--radius); }
  .files:empty { display: none; }
  .files li { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-top: 1px solid var(--line); flex-wrap: wrap; }
  .files li:first-child { border-top: 0; }
  .files .n { font-family: var(--mono); font-size: 12px; color: var(--muted); width: 2ch; text-align: right; }
  .files .name { flex: 1 1 200px; word-break: break-all; }
  .files .meta { font-family: var(--mono); font-size: 13px; color: var(--muted); }
  .files .ok { color: var(--ok); }
  .files .warn { color: var(--bad); }
  .files .thumb { width: 40px; height: 40px; object-fit: cover; border-radius: 4px; border: 1px solid var(--line); background: var(--soft); }
  .icon { font: inherit; font-size: 13px; line-height: 1; background: transparent; color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius); padding: 7px 9px; cursor: pointer; }
  .icon:disabled { opacity: .35; cursor: default; }
  .opts { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: flex-end; padding: 14px 0; border-top: 1px solid var(--line); }
  .opts label { display: flex; flex-direction: column; gap: 4px; font-size: 14px; color: var(--muted); }
  .opts label.check { flex-direction: row; align-items: center; gap: 8px; color: var(--ink); }
  .opts .full { width: 100%; }
  .hint { width: 100%; color: var(--muted); font-size: 14px; margin: 0; }
  .seg { display: inline-flex; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .seg label { flex-direction: row !important; color: var(--ink) !important; gap: 0 !important; }
  .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { padding: 8px 12px; font-size: 14px; cursor: pointer; border-left: 1px solid var(--line); }
  .seg label:first-child span { border-left: 0; }
  .seg input:checked + span { background: var(--ink); color: var(--bg); }
  .seg input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: -2px; }
  input[type='text'], input[type='number'], input:not([type]), select, textarea { font: inherit; font-size: 15px; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); padding: 8px 10px; min-width: 0; }
  input[type='number'] { width: 110px; }
  input[type='range'] { accent-color: var(--accent); width: 180px; }
  textarea { width: 100%; font-family: var(--mono); font-size: 13px; line-height: 1.5; resize: vertical; }
  input:focus-visible, select:focus-visible, button:focus-visible, textarea:focus-visible, .drop:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding-top: 14px; border-top: 1px solid var(--line); }
  .primary { font: inherit; font-weight: 600; background: var(--accent); color: var(--accent-ink); border: 0; border-radius: var(--radius); padding: 11px 18px; cursor: pointer; }
  .primary:disabled { opacity: .5; cursor: default; }
  .primary:active:not(:disabled) { transform: translateY(1px); }
  .secondary { font: inherit; background: transparent; color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius); padding: 10px 14px; cursor: pointer; }
  .link { font: inherit; font-size: 14px; background: none; border: 0; padding: 0; color: var(--accent); text-decoration: underline; cursor: pointer; }
  .status { font-size: 14px; color: var(--muted); }
  .error { color: var(--bad); font-size: 14px; margin: 10px 0 0; }
  .preview { margin-top: 14px; overflow: auto; max-height: 360px; border: 1px solid var(--line); border-radius: var(--radius); }
  table { border-collapse: collapse; width: 100%; font-size: 13px; font-family: var(--mono); }
  th { position: sticky; top: 0; background: var(--card); text-align: left; color: var(--muted); font-weight: 500; border-bottom: 1px solid var(--line); padding: 6px 8px; white-space: nowrap; }
  td { border-bottom: 1px solid var(--line); padding: 5px 8px; vertical-align: top; white-space: nowrap; max-width: 280px; overflow: hidden; text-overflow: ellipsis; }
  [hidden] { display: none !important; }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
